<!--
  The Rewind OS installer (WiX 5): per machine, into Program Files\Rewind OS, with a Start menu
  shortcut. A newer version replaces the installed one; an older one refuses to install over it.
  Built by packaging/windows/package.ps1:
    wix build -arch <x64|arm64> -d Version=<1.2.3> -d BinDir=<folder> -d DocDir=<folder> ...
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Rewind OS"
           Manufacturer="Rewind OS"
           Version="$(Version)"
           UpgradeCode="7ab7b446-f192-4328-a242-828a3a95ceec"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Rewind OS is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Windows Installer saves the icon under its Id; without the .ico extension Explorer cannot
         read it and the Start menu shortcut and the Settings entry show a blank icon. -->
    <Icon Id="AppIcon.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/rewind-os/rewind-os-app" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Rewind OS">
        <Component Id="App">
          <File Id="RewindOsExe" Source="$(BinDir)\rewind-os.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Rewind OS"
                      Description="See what uses your disk and remove what you do not need"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon.ico"
                      Advertise="yes" />
          </File>
        </Component>
        <Component Id="Cli">
          <File Id="RewindOsCliExe" Source="$(BinDir)\rewind-os-cli.exe" KeyPath="yes" />
        </Component>
        <!-- One file per component: text files have no version, so each needs its own key path. -->
        <Component Id="Readme"><File Id="Readme" Source="$(DocDir)\README.md" KeyPath="yes" /></Component>
        <Component Id="ReadmeEs"><File Id="ReadmeEs" Source="$(DocDir)\README.es.md" KeyPath="yes" /></Component>
        <Component Id="LicenseMit"><File Id="LicenseMit" Source="$(DocDir)\LICENSE-MIT" KeyPath="yes" /></Component>
        <Component Id="LicenseApache"><File Id="LicenseApache" Source="$(DocDir)\LICENSE-APACHE" KeyPath="yes" /></Component>
        <Component Id="Notice"><File Id="Notice" Source="$(DocDir)\NOTICE" KeyPath="yes" /></Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
